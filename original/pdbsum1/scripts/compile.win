gfortran -o tplot -static tplot.o ps.o -lm
gfortran -fbounds-check -o secstr -static ../src/procheck/secstr.f

gfortran -fbounds-check -o p_bulge3 -static ../src/promotif3/p_bulge3.f -lm
gfortran -fbounds-check -o p_disulph3  -static ../src/promotif3/p_disulph3.f -lm
gfortran -fbounds-check -o p_hairpin3 -static ../src/promotif3/p_hairpin3.f -lm
gfortran -fbounds-check -o p_helix3 -static ../src/promotif3/p_helix3.f -lm
gfortran -fbounds-check -o p_hera3 -static ../src/promotif3/p_hera3.f -lm
gfortran -fbounds-check -o p_sheet3 -static ../src/promotif3/p_sheet3.f -lm
gfortran -fbounds-check -o p_sstruc3 -static ../src/promotif3/p_sstruc3.f -lm
gfortran -fbounds-check -o p_turn3 -static ../src/promotif3/p_turn3.f -lm
gfortran -fbounds-check -c ../src/promotif3/psrout.f -lm
gfortran -fbounds-check -c ../src/promotif3/psplot3.f -lm
