# FORTRAN programs

gfortran -fbounds-check -static -o naccess ../src/naccess/naccess.f -lm

gfortran -fbounds-check -c ../src/pdbsum/fcommon.f
gfortran -fbounds-check -c ../src/pdbsum/pdbhtml.f
gfortran -o pdbhtml -static pdbhtml.o fcommon.o -lm

gfortran -fbounds-check -c ../src/procheck/ps.f
gfortran -fbounds-check -o anglen -static ../src/procheck/anglen.f
gfortran -fbounds-check -o clean -static ../src/procheck/clean.f
gfortran -fbounds-check -c ../src/procheck/bplot.f
gfortran -o bplot -static bplot.o ps.o -lm
